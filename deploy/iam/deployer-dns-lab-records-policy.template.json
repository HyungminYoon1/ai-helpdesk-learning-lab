{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDnsLabZoneList",
      "Effect": "Allow",
      "Action": [
        "route53:GetHostedZoneCount",
        "route53:ListHostedZones",
        "route53:ListHostedZonesByName"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "us-east-1" },
        "Bool": { "aws:MultiFactorAuthPresent": "true" }
      }
    },
    {
      "Sid": "ReadOnlyDnsLabZone",
      "Effect": "Allow",
      "Action": ["route53:GetHostedZone", "route53:ListResourceRecordSets"],
      "Resource": "arn:aws:route53:::hostedzone/<DNS_LAB_ZONE_ID>",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "us-east-1" },
        "Bool": { "aws:MultiFactorAuthPresent": "true" }
      }
    },
    {
      "Sid": "CreateOnlyDnsLabProofTxt",
      "Effect": "Allow",
      "Action": ["route53:ChangeResourceRecordSets"],
      "Resource": "arn:aws:route53:::hostedzone/<DNS_LAB_ZONE_ID>",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "us-east-1" },
        "Bool": { "aws:MultiFactorAuthPresent": "true" },
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": ["proof.dns-lab.hmyoon.com"],
          "route53:ChangeResourceRecordSetsRecordTypes": ["TXT"],
          "route53:ChangeResourceRecordSetsActions": ["CREATE"]
        },
        "Null": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": "false",
          "route53:ChangeResourceRecordSetsRecordTypes": "false",
          "route53:ChangeResourceRecordSetsActions": "false"
        }
      }
    },
    {
      "Sid": "CreateOnlyDnsLabAliasA",
      "Effect": "Allow",
      "Action": ["route53:ChangeResourceRecordSets"],
      "Resource": "arn:aws:route53:::hostedzone/<DNS_LAB_ZONE_ID>",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "us-east-1" },
        "Bool": { "aws:MultiFactorAuthPresent": "true" },
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": ["dns-lab.hmyoon.com"],
          "route53:ChangeResourceRecordSetsRecordTypes": ["A"],
          "route53:ChangeResourceRecordSetsActions": ["CREATE"]
        },
        "Null": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": "false",
          "route53:ChangeResourceRecordSetsRecordTypes": "false",
          "route53:ChangeResourceRecordSetsActions": "false"
        }
      }
    },
    {
      "Sid": "ReadDnsLabChangeStatus",
      "Effect": "Allow",
      "Action": ["route53:GetChange"],
      "Resource": "arn:aws:route53:::change/*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "us-east-1" },
        "Bool": { "aws:MultiFactorAuthPresent": "true" }
      }
    }
  ]
}
