{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RequireMfaExceptSelfEnrollment",
      "Effect": "Deny",
      "NotAction": [
        "iam:CreateVirtualMFADevice",
        "iam:EnableMFADevice",
        "iam:ResyncMFADevice",
        "iam:ListMFADevices",
        "iam:ListVirtualMFADevices",
        "iam:GetUser",
        "iam:GetAccountPasswordPolicy",
        "sts:GetSessionToken"
      ],
      "Resource": "*",
      "Condition": {
        "BoolIfExists": {
          "aws:MultiFactorAuthPresent": "false",
          "aws:ViaAWSService": "false"
        }
      }
    },
    {
      "Sid": "RestrictRegionalOperationsToSeoul",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "sts:GetCallerIdentity",
        "sts:GetSessionToken",
        "route53:GetHostedZoneCount",
        "route53:ListHostedZones",
        "route53:ListHostedZonesByName",
        "route53:GetHostedZone",
        "route53:ListResourceRecordSets",
        "route53:ChangeResourceRecordSets",
        "route53:GetChange",
        "route53:GetDNSSEC",
        "route53:DeleteHostedZone"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    },
    {
      "Sid": "ReadMfaEnrollmentMetadata",
      "Effect": "Allow",
      "Action": [
        "iam:GetAccountPasswordPolicy",
        "iam:ListVirtualMFADevices"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageOnlyOwnMfaAndPassword",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser",
        "iam:ListMFADevices",
        "iam:EnableMFADevice",
        "iam:ResyncMFADevice",
        "iam:ChangePassword"
      ],
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:user/helpdesk-deployer"
    },
    {
      "Sid": "CreateOnlyOwnVirtualMfa",
      "Effect": "Allow",
      "Action": [
        "iam:CreateVirtualMFADevice"
      ],
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:mfa/helpdesk-deployer"
    },
    {
      "Sid": "ReadNetworkAndRoleMetadata",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeVpcAttribute",
        "ec2:DescribeSubnets",
        "ec2:DescribeRouteTables",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeAccountAttributes",
        "ec2:DescribeTags",
        "iam:ListRoles"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadOnlyExecutionRole",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListRolePolicies",
        "iam:GetRolePolicy"
      ],
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/helpdesk-ecs-execution"
    },
    {
      "Sid": "PassOnlyExecutionRoleToEcs",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/helpdesk-ecs-execution",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "CreateOnlyRequiredServiceLinkedRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": [
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/aws-service-role/ecs.amazonaws.com/AWSServiceRoleForECS",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/aws-service-role/rds.amazonaws.com/AWSServiceRoleForRDS",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/aws-service-role/elasticloadbalancing.amazonaws.com/AWSServiceRoleForElasticLoadBalancing"
      ],
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com",
            "rds.amazonaws.com",
            "elasticloadbalancing.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CreateTaggedNetworkResources",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateInternetGateway",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:vpc/*",
        "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:route-table/*",
        "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:internet-gateway/*",
        "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "helpdesk-learning"
        }
      }
    },
    {
      "Sid": "CreateChildrenOnlyInTaggedVpc",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "helpdesk-learning"
        }
      }
    },
    {
      "Sid": "DenyChildrenInOtherVpcs",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:vpc/*",
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/Project": "helpdesk-learning"
        }
      }
    },
    {
      "Sid": "ConfigureOnlyTaggedNetworkResources",
      "Effect": "Allow",
      "Action": [
        "ec2:AttachInternetGateway",
        "ec2:AssociateRouteTable",
        "ec2:CreateRoute",
        "ec2:ModifyVpcAttribute",
        "ec2:ModifySubnetAttribute",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:vpc/*",
        "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:route-table/*",
        "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:internet-gateway/*",
        "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "helpdesk-learning"
        }
      }
    },
    {
      "Sid": "TagNetworkOnlyAtCreation",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:vpc/*",
        "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:route-table/*",
        "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:internet-gateway/*",
        "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:security-group/*",
        "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:security-group-rule/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "helpdesk-learning",
          "ec2:CreateAction": [
            "CreateVpc",
            "CreateSubnet",
            "CreateRouteTable",
            "CreateInternetGateway",
            "CreateSecurityGroup",
            "AuthorizeSecurityGroupIngress",
            "AuthorizeSecurityGroupEgress"
          ]
        }
      }
    },
    {
      "Sid": "CreateTaggedRulesOnlyInOwnedGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress"
      ],
      "Resource": "arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:security-group-rule/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "helpdesk-learning"
        }
      }
    }
  ]
}
