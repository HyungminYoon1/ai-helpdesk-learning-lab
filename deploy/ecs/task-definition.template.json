{
  "family": "helpdesk-learning",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "cpu": "<TASK_CPU_UNITS>",
  "memory": "<TASK_MEMORY_MIB>",
  "executionRoleArn": "<ECS_EXECUTION_ROLE_ARN>",
  "containerDefinitions": [
    {
      "name": "helpdesk",
      "image": "<VERIFIED_ECR_IMAGE_URI_WITH_MANIFEST_DIGEST>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "postgres,deployment"
        },
        {
          "name": "HELPDESK_AI_PROVIDER_ENABLED",
          "value": "false"
        },
        {
          "name": "HELPDESK_AI_WORKER_ENABLED",
          "value": "false"
        },
        {
          "name": "SPRING_DATASOURCE_URL",
          "value": "jdbc:postgresql://<RDS_ENDPOINT>:5432/<DB_NAME>?sslmode=verify-full&sslrootcert=/app/certs/rds-ca-bundle.pem"
        },
        {
          "name": "SPRING_APPLICATION_JSON",
          "value": "{\"server\":{\"forward-headers-strategy\":\"native\",\"servlet\":{\"session\":{\"cookie\":{\"secure\":true,\"http-only\":true,\"same-site\":\"lax\"}}}}}"
        }
      ],
      "secrets": [
        {
          "name": "SPRING_DATASOURCE_USERNAME",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:<AWS_ACCOUNT_ID>:parameter/helpdesk/learning/db/username"
        },
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:<AWS_ACCOUNT_ID>:parameter/helpdesk/learning/db/password"
        },
        {
          "name": "HELPDESK_DEPLOYMENT_USER_USERNAME",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:<AWS_ACCOUNT_ID>:parameter/helpdesk/learning/user/username"
        },
        {
          "name": "HELPDESK_DEPLOYMENT_USER_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:<AWS_ACCOUNT_ID>:parameter/helpdesk/learning/user/password"
        },
        {
          "name": "HELPDESK_DEPLOYMENT_AGENT_USERNAME",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:<AWS_ACCOUNT_ID>:parameter/helpdesk/learning/agent/username"
        },
        {
          "name": "HELPDESK_DEPLOYMENT_AGENT_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:<AWS_ACCOUNT_ID>:parameter/helpdesk/learning/agent/password"
        }
      ],
      "stopTimeout": 45,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "ap-northeast-2",
          "awslogs-group": "<PRECREATED_LOG_GROUP_NAME>",
          "awslogs-stream-prefix": "helpdesk"
        }
      }
    }
  ]
}
